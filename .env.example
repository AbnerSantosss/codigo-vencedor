# ---- Banco ----------------------------------------------------------------
POSTGRES_USER=codigovencedor
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=codigovencedor
# Local (fora do Docker): postgresql://user:senha@localhost:5432/codigovencedor
DATABASE_URL=postgresql://codigovencedor:troque-esta-senha@db:5432/codigovencedor

# ---- Aplicação ------------------------------------------------------------
NODE_ENV=production
PORT=3000
HOST=0.0.0.0
# Domínio final. Entra em e-mails, webhooks e no event_source_url das conversões.
PUBLIC_URL=https://seudominio.com.br
LOG_LEVEL=info

# Ligue quando estiver atrás do Cloudflare Tunnel: faz o rate limit enxergar
# o IP real do visitante em vez do IP do cloudflared.
TRUST_CLOUDFLARE=true

# ---- Segredos -------------------------------------------------------------
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=

# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# ATENÇÃO: perder esta chave torna CPFs e credenciais de gateway ilegíveis.
ENCRYPTION_KEY=

# ---- Primeiro admin -------------------------------------------------------
# Usados só no primeiro boot, pelo seed. Depois disso pode remover.
# A troca de senha é obrigatória no primeiro login.
ADMIN_EMAIL=voce@exemplo.com
ADMIN_PASSWORD=

# ---- Cloudflare Tunnel ----------------------------------------------------
# Token do túnel criado em Cloudflare Zero Trust → Networks → Tunnels.
# No painel do túnel, o Public Hostname aponta para http://api:3000.
# É um segredo: vive só na stack do Portainer, nunca no repositório.
CLOUDFLARE_TUNNEL_TOKEN=

# ---- Backups --------------------------------------------------------------
# Caminho absoluto no host da VPS onde os dumps diários são gravados.
# Precisa existir antes do primeiro deploy: mkdir -p /opt/codigo-vencedor/backups
BACKUP_DIR=/opt/codigo-vencedor/backups
